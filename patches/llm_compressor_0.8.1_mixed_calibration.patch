+                        (~mask[:, i1:i2])
+                        * W1**2
+                        / (torch.diag(Hinv1).reshape((1, -1))) ** 2
+                    )
+                    thresh = torch.sort(tmp.flatten())[0][int(tmp.numel() * sparsity)]
+                    mask1 = tmp <= thresh
+            else:
+                tmp = W1**2 / (torch.diag(Hinv1).reshape((1, -1))) ** 2
+                thresh = torch.sort(tmp.flatten())[0][int(tmp.numel() * sparsity)]
+                mask1 = tmp <= thresh
