+            if prune_n != 0 and i % prune_m == 0:
+                tmp = (
+                    W1[:, i : (i + prune_m)] ** 2
+                    / (torch.diag(Hinv1)[i : (i + prune_m)].reshape((1, -1))) ** 2
+                )
+                if mask is not None:
+                    tmp = tmp * (~mask[:, i : (i + prune_m)])
+
+                mask1.scatter_(
+                    1, i + torch.topk(tmp, prune_n, dim=1, largest=False)[1], True
+                )
